#!/bin/bash
# T5 on one H100 node: per model, a new trace (examples 240.. of each domain, generated by the offloaded runtime),
# its replay spec (disjoint by prompt hash from every earlier trace), the four policies interleaved at both
# capacities (two passes), and the copy-cost sweep on OLMoE and Qwen3. Steps skip finished output, so a resubmission
# resumes. Submit from the repository root:  sbatch jobs/t5.sbatch
#SBATCH --job-name=t5
#SBATCH --gpus=h100:4
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --time=24:00:00
#SBATCH --output=t5-%j.out
set -uo pipefail
LOG=logs/t5.log
source jobs/common.sh
export CUDA_VISIBLE_DEVICES=0
OFFSET=240
R=data/rankers
OUT=data/runs/t5
COMMON=(--placement physical --monitor --lean --copy-api driver --warmup 1 --gpu-index 0)
ARMS=(lfu_decay hobbit splitphase global_token_gbt)
host_info
step tests
python -m unittest tests.test_hardware tests.test_baselines tests.test_prefetch_architectures -q >> "$LOG" 2>&1 || fail tests
step "copy issue cost"
python -u src/runtime/bench_copy_issue.py 2>&1 | tee -a "$LOG" || skip "copy benchmark"

# trace NAME KEY PER_DOMAIN GEN_B: new trace and replay spec
trace() {
  local NAME=$1 KEY=$2 PER=$3 GEN=$4 CONFIG
  local TRACE=data/traces/${NAME}_t5 SPEC=data/specs/${NAME}_t5_replay_spec.json
  case $KEY in olmoe) CONFIG=measurement/stage3_residency/configs/full_preregistered.json ;; *) CONFIG=configs/trace_${KEY}.json ;; esac
  if [ ! -f "$TRACE/routing_trace.npz" ]; then
    step "$NAME: generate trace (examples $OFFSET-$((OFFSET + PER - 1)) of each domain)"
    python -u src/runtime/fresh_trace_offloaded.py generate --opt-root measurement --base-config "$CONFIG" --offset $OFFSET \
      --prompts-per-domain $PER --capacity $GEN --output-dir "$TRACE" >> "$LOG" 2>&1 || { skip "$NAME generate"; return 1; }
  fi
  if [ ! -f "$SPEC" ]; then
    step "$NAME: replay spec"
    python -u src/runtime/fresh_trace_offloaded.py spec --opt-root measurement --trace-root "$TRACE" --output "$SPEC" \
      --original-metadata "${META_T1_T4[@]}" >> "$LOG" 2>&1 || { skip "$NAME spec"; return 1; }
  fi
}

# arms NAME CAP PASSES SEQUENCES K FLAGS...: the four policies interleaved; every expert copy issued K times
arms() {
  local NAME=$1 CAP=$2 PASSES=$3 SEQS=$4 K=$5; shift 5
  local SPEC=data/specs/${NAME}_t5_replay_spec.json TAG=B$CAP
  [ "$K" != 1 ] && TAG=B${CAP}_K$K
  mkdir -p "$OUT/$NAME"
  [ -f "$OUT/$NAME/$TAG.json" ] && return 0
  step "$NAME: arms $TAG, $PASSES pass(es)"
  python -u src/runtime/interleaved_h100.py --spec "$SPEC" --capacity "$CAP" --sequences "$SEQS" --passes "$PASSES" \
    --copy-repeat "$K" "${COMMON[@]}" --hobbit-w "$(hobbit_w "$NAME" frozen "$CAP")" "$@" --arms "${ARMS[@]}" \
    --output "$OUT/$NAME/$TAG.json" --label "t5/$NAME/$TAG" >> "$LOG" 2>&1 || skip "$NAME arms $TAG"
}

MX=(--experts-on-host --p2-bundle $R/mixtral_8x7b_frozen_lag_req_trees200.pkl
    --p1-bundle $R/mixtral_8x7b_frozen_lag_tok_trees200.pkl --sync-bundle $R/mixtral_8x7b_dev_trees800.pkl)
if trace mixtral mixtral_8x7b 10 5; then
  for CAP in 4 3; do arms mixtral "$CAP" 2 calibration 1 "${MX[@]}"; done
fi
OL=(--p2-bundle $R/olmoe_frozen_lag_req_trees200.pkl --p1-bundle $R/olmoe_frozen_lag_tok_trees200.pkl
    --sync-bundle $R/olmoe_setdev_policy.pkl)
if trace olmoe olmoe 40 32; then
  for CAP in 32 24; do arms olmoe "$CAP" 2 calibration 1 "${OL[@]}"; done
  FIRST=$(ids data/specs/olmoe_t5_replay_spec.json 40)
  for K in 2 4 16 32; do arms olmoe 32 1 "$FIRST" "$K" "${OL[@]}"; done
fi
QW=(--experts-on-host --p2-bundle $R/qwen3_30b_a3b_frozen_lag_req_trees200.pkl
    --p1-bundle $R/qwen3_30b_a3b_frozen_lag_tok_trees200.pkl --sync-bundle $R/qwen3_30b_a3b_dev_trees800.pkl)
if trace qwen3 qwen3_30b_a3b 20 64; then
  for CAP in 64 48; do arms qwen3 "$CAP" 2 calibration 1 "${QW[@]}"; done
  FIRST=$(ids data/specs/qwen3_t5_replay_spec.json 20)
  for K in 4 16; do arms qwen3 64 1 "$FIRST" "$K" "${QW[@]}"; done
fi
grep -q "^FAILED" "$LOG" && step "finished with failures (see FAILED lines)" || step done
